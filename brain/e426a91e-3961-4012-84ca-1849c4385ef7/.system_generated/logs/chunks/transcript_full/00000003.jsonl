   id: inNode.id,\n              label: inNode.label || inNode.id,\n              x: inNode.x > 1 ? inNode.x / 640 : (inNode.x || 0.5),\n              y: inNode.y > 1 ? inNode.y / 480 : (inNode.y || 0.5),\n              color: \"#38bdf8\",\n              pulse: 0.8,\n              connectedTo: [\"submit\"]\n            });\n          }\n        });\n\n        const cacheBadge = document.getElementById(\"memory-cache-badge\");\n        if (cacheBadge) cacheBadge.innerText = `${memoryNodes.length} NODES SYNCED`;\n        renderMemoryNodesList();\n      }\n    }\n\n    function renderMemoryNodesList() {\n      const list = document.getElementById(\"memory-nodes-list\");\n      if (!list) return;\n      list.innerHTML = \"\";\n      memoryNodes.forEach(node => {\n        const div = document.createElement(\"div\");\n        div.className = \"flex justify-between items-center text-slate-300 py-0.5 border-b border-slate-900\";\n        div.innerHTML = `\n          <span style=\"color: ${node.color}\">● node_${node.id}</span>\n          <span class=\"text-slate-500\">(x:${Math.round(node.x * 640)}, y:${Math.round(node.y * 480)})</span>\n          <span class=\"text-[10px]\" style=\"color: ${node.color}\">SYNCED</span>\n        `;\n        list.appendChild(div);\n      });\n    }\n\n    // Requirement 1: WebSocket connection to ws://172.18.238.74:8000/ws/telemetry\n    function connectTelemetryWebSocket() {\n      if (wsReconnectTimeout) clearTimeout(wsReconnectTimeout);\n\n      const wsBadge = document.getElementById(\"ws-status-badge\");\n      const wsText = document.getElementById(\"ws-status-text\");\n      const wsDot = document.getElementById(\"ws-indicator-dot\");\n\n      if (be2Socket) {\n        try { be2Socket.close(); } catch(e) {}\n      }\n\n      if (wsText) wsText.innerText = `WS: CONNECTING (${BE2_HOST})`;\n      if (wsBadge) wsBadge.className = \"px-3 py-1 rounded-full bg-slate-900 border border-slate-700 text-slate-400 flex items-center space-x-2 font-mono text-[11px]\";\n      if (wsDot) wsDot.className = \"w-2 h-2 rounded-full bg-amber-400 animate-ping\";\n\n      try {\n        be2Socket = new WebSocket(BE2_WS_URL);\n\n        be2Socket.onopen = () => {\n          if (wsText) wsText.innerText = `WS: LIVE (${BE2_HOST})`;\n          if (wsBadge) wsBadge.className = \"px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/50 text-emerald-300 flex items-center space-x-2 font-mono text-[11px] shadow-[0_0_12px_rgba(16,185,129,0.3)]\";\n          if (wsDot) wsDot.className = \"w-2 h-2 rounded-full bg-emerald-400\";\n          addLog(`✔ Connected to BE2 WebSocket stream (${BE2_WS_URL})`, \"success\");\n          playSynthSound('blip');\n        };\n\n        be2Socket.onmessage = (msg) => {\n          let payload = null;\n          try {\n            payload = JSON.parse(msg.data);\n          } catch(e) {\n            payload = { event: msg.data };\n          }\n          handleBE2TelemetryMessage(payload);\n        };\n\n        be2Socket.onerror = (err) => {\n          if (wsText) wsText.innerText = `WS: OFFLINE (${BE2_HOST})`;\n          if (wsBadge) wsBadge.className = \"px-3 py-1 rounded-full bg-rose-950/80 border border-rose-500/50 text-rose-300 flex items-center space-x-2 font-mono text-[11px]\";\n          if (wsDot) wsDot.className = \"w-2 h-2 rounded-full bg-rose-400\";\n        };\n\n        be2Socket.onclose = () => {\n          if (wsText) wsText.innerText = \"WS: RECONNECTING IN 4s...\";\n          if (wsBadge) wsBadge.className = \"px-3 py-1 rounded-full bg-slate-900 border border-amber-700/50 text-amber-400 flex items-center space-x-2 font-mono text-[11px]\";\n          if (wsDot) wsDot.className = \"w-2 h-2 rounded-full bg-amber-400 animate-pulse\";\n          wsReconnectTimeout = setTimeout(connectTelemetryWebSocket, 4000);\n        };\n      } catch (err) {\n        console.warn(\"WebSocket init error:\", err);\n        wsReconnectTimeout = setTimeout(connectTelemetryWebSocket, 5000);\n      }\n    }\n\n    function handleBE2TelemetryMessage(data) {\n      const eventName = data.event || data.type || data.event_type || data.action || (typeof data === \"string\" ? data : \"\");\n\n      // Requirement 2: When \"MEMORY_DRIFT_DETECTED\" arrives\n      if (eventName === \"MEMORY_DRIFT_DETECTED\" || (typeof eventName === \"string\" && eventName.includes(\"DRIFT_DETECTED\"))) {\n        const deltaX = data.delta_x !== undefined ? data.delta_x : (data.dx !== undefined ? data.dx : 120);\n        triggerMemoryDriftAlert(deltaX, data);\n      }\n      // Requirement 3: When \"SELF_HEALING_COMPLETED\" arrives\n      else if (eventName === \"SELF_HEALING_COMPLETED\" || (typeof eventName === \"string\" && eventName.includes(\"SELF_HEALING\"))) {\n        triggerSelfHealingCompleted(data);\n      } else {\n        addLog(`[BE2 TELEMETRY] ${JSON.stringify(data)}`, \"info\");\n      }\n    }\n\n    // Requirement 2: Live warning alert on HUD showing button relocated by Δx=+120px\n    function triggerMemoryDriftAlert(deltaX = 120, rawData = {}) {\n      addLog(`⚠ [BE2 TELEMETRY] MEMORY_DRIFT_DETECTED: Button relocated by Δx=+${deltaX}px!`, \"warn\");\n      playSynthSound('heal');\n\n      // 1. Show live warning alert on HUD\n      const alertCard = document.getElementById(\"be2-drift-alert\");\n      const alertMsg = document.getElementById(\"be2-drift-msg\");\n      if (alertCard && alertMsg) {\n        alertMsg.innerText = `Button relocated by Δx=+${deltaX}px (Spatial Recalibration Engaged)`;\n        alertCard.style.opacity = \"1\";\n        alertCard.style.transform = \"translate(-50%, 0)\";\n      }\n\n      // Also show the bottom banner inside ERP view\n      const banner = document.getElementById(\"drift-alert-banner\");\n      if (banner) {\n        banner.innerHTML = `\n          <div class=\"flex items-center space-x-1.5\">\n            <span class=\"animate-ping w-2 h-2 rounded-full bg-slate-950\"></span>\n            <span>⚡ BE2 DRIFT: BUTTON RELOCATED (Δx=+${deltaX}px)</span>\n          </div>\n          <span class=\"text-[9px] px-1.5 py-0.5 rounded bg-black text-amber-300\">DRIFT DETECTED</span>\n        `;\n        banner.style.opacity = \"1\";\n        banner.style.transform = \"translateY(0)\";\n      }\n\n      // 2. Relocate button in the ERP view by +120px\n      const btn = document.getElementById(\"btn-erp-submit\");\n      if (btn) {\n        btn.style.transition = \"all 0.4s ease\";\n        btn.style.transform = `translateX(${deltaX}px)`;\n        btn.className = \"px-4 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded shadow-lg transition-all\";\n        btn.innerHTML = `<span>>> SUBMIT [RELOCATED +${deltaX}px] <<</span>`;\n      }\n\n      // 3. Update Status Badge\n      const statusText = document.getElementById(\"system-status-text\");\n      const statusBadge = document.getElementById(\"system-status-badge\");\n      if (statusText) statusText.innerText = `⚡ DRIFT DETECTED (Δx=+${deltaX}px) // RELOCALIZING`;\n      if (statusBadge) statusBadge.className = \"px-3 py-1 rounded-full bg-amber-950/80 border border-amber-500/50 text-amber-300 flex items-center space-x-2\";\n\n      // 4. Trigger Relocalization Vector Animation on Canvas\n      const submitNode = memoryNodes.find(n => n.id === \"submit\");\n      if (submitNode) {\n        submitNode.pulse = 1.0;\n        submitNode.color = \"#f59e0b\"; // Warning amber\n        driftVectorAnim = {\n          fromX: submitNode.x,\n          fromY: submitNode.y,\n          toX: Math.min(0.85, submitNode.x + (deltaX / 640)),\n          toY: submitNode.y,\n          progress: 0\n        };\n      }\n\n      // Auto-hide alert banner after 6s if not healed earlier\n      setTimeout(() => {\n        if (alertCard && alertCard.style.opacity === \"1\") {\n          alertCard.style.opacity = \"0\";\n          alertCard.style.transform = \"translate(-50%, -6rem)\";\n        }\n      }, 6000);\n    }\n\n    // Requirement 3: Flash green success card on HUD & turn node emerald green (#10b981)\n    function triggerSelfHealingCompleted(rawData = {}) {\n      addLog(\"✔ [BE2 TELEMETRY] SELF_HEALING_COMPLETED: Node re-anchored. Muscle memory verified.\", \"success\");\n      playSynthSound('blip');\n\n      // Hide drift warning alert\n      const driftAlert = document.getElementById(\"be2-drift-alert\");\n      if (driftAlert) {\n        driftAlert.style.opacity = \"0\";\n        driftAlert.style.transform = \"translate(-50%, -6rem)\";\n      }\n      const banner = document.getElementById(\"drift-alert-banner\");\n      if (banner) {\n        banner.style.opacity = \"0\";\n        banner.style.transform = \"translateY(48px)\";\n      }\n\n      // 1. Flash green success card on the HUD\n      const successCard = document.getElementById(\"be2-heal-success-card\");\n      if (successCard) {\n        successCard.style.opacity = \"1\";\n        successCard.style.transform = \"translate(-50%, 0)\";\n        setTimeout(() => {\n          successCard.style.opacity = \"0\";\n          successCard.style.transform = \"translate(-50%, -6rem)\";\n        }, 5000);\n      }\n\n      // Also trigger center column toast\n      const toast = document.getElementById(\"self-heal-toast\");\n      if (toast) {\n        toast.style.opacity = \"1\";\n        toast.style.transform = \"translateY(0)\";\n        setTimeout(() => { toast.style.opacity = \"0\"; }, 4000);\n      }\n\n      // 2. Turn that node emerald green (#10b981)\n      const submitNode = memoryNodes.find(n => n.id === \"submit\");\n      if (submitNode) {\n        if (driftVectorAnim) {\n          submitNode.x = driftVectorAnim.toX;\n        }\n        submitNode.color = \"#10b981\"; // Emerald Green\n        submitNode.pulse = 1.0;\n        driftVectorAnim = null;\n      }\n\n      // Update Node list table in the UI\n      const nodeStatus = document.getElementById(\"node-submit-status\");\n      const nodeCoords = document.getElementById(\"node-submit-coords\");\n      if (nodeStatus) {\n        nodeStatus.innerText = \"HEALED (#10b981)\";\n        nodeStatus.style.color = \"#10b981\";\n        nodeStatus.className = \"text-[#10b981] font-bold text-[10px]\";\n      }\n      if (nodeCoords) {\n        nodeCoords.innerText = `(x:${Math.round((submitNode ? submitNode.x : 0.68) * 640)}, y:230) [HEALED]`;\n      }\n\n      // Update HUD status & metrics\n      const statusText = document.getElementById(\"system-status-text\");\n      const statusBadge = document.getElementById(\"system-status-badge\");\n      if (statusText) statusText.innerText = \"✔ ADAPTATION COMPLETE // MUSCLE MEMORY SYNCED\";\n      if (statusBadge) statusBadge.className = \"px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/50 text-emerald-300 flex items-center space-x-2\";\n      \n      const conf = document.getElementById(\"graph-confidence\");\n      if (conf) conf.innerText = \"100.0%\";\n      const driftsCount = document.getElementById(\"graph-drifts\");\n      if (driftsCount) driftsCount.innerText = (parseInt(driftsCount.innerText || \"0\") + 1).toString();\n\n      // Normalize the button in ERP view to green/healed\n      const btn = document.getElementById(\"btn-erp-submit\");\n      if (btn) {\n        btn.className = \"px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded shadow-md transition-all\";\n        btn.innerHTML = \"<span>[ Process & Wire Payout ] ✔</span>\";\n      }\n    }\n\n    // Manual test triggers\n    function testBE2Drift() {\n      handleBE2TelemetryMessage({ event: \"MEMORY_DRIFT_DETECTED\", delta_x: 120 });\n    }\n\n    function testBE2Healed() {\n      handleBE2TelemetryMessage({ event: \"SELF_HEALING_COMPLETED\" });\n    }\n\n    // Auto-initialize on load\n    window.addEventListener(\"DOMContentLoaded\", () => {\n      fetchInitialMemoryGraph();\n      connectTelemetryWebSocket();\n    });\n'''\n\nfor file_path in files:\n    if not file_path.exists():\n        continue\n    content = file_path.read_text(encoding=\"utf-8\")\n\n    # 1. Insert WS status badge into header if not present\n    if 'id=\"ws-status-badge\"' not in content:\n        target = '<div id=\"system-status-badge\"'\n        content = content.replace(target, ws_badge_html + '\\n      ' + target)\n\n    # 2. Insert alert cards right after <body>\n    if 'id=\"be2-drift-alert\"' not in content:\n        target = '<body class=\"min-h-screen'\n        idx = content.find('>', content.find(target)) + 1\n        content = content[:idx] + '\\n' + alert_cards_html + '\\n' + content[idx:]\n\n    # 3. Add test buttons to the footer bar\n    if 'testBE2Drift()' not in content:\n        target = '<button onclick=\"simulateManualAttack()\"'\n        extra_btns = '''<button onclick=\"testBE2Drift()\" class=\"text-amber-400 hover:text-amber-300 text-[10px] underline\">[⚡ Test BE2 Drift (+120px)]</button>\n            <button onclick=\"testBE2Healed()\" class=\"text-emerald-400 hover:text-emerald-300 text-[10px] underline\">[✔ Test BE2 Healed]</button>\n            <button onclick=\"connectTelemetryWebSocket()\" class=\"text-cyan-400 hover:text-cyan-300 text-[10px] underline\">[↺ Reconnect WS]</button>\n            '''\n        content = content.replace(target, extra_btns + target)\n\n    # 4. Insert BE2 script code before </script>\n    if 'BE2_HOST' not in content:\n        content = content.replace('</script>', be2_script_code + '\\n  </script>')\n\n    file_path.write_text(content, encoding=\"utf-8\")\n    print(f\"Successfully updated {file_path.name}\")\n'@ | python -\n","Cwd":"C:\\Users\\Piyush\\.gemini\\antigravity\\scratch\\aegis_os","WaitMsBeforeAsync":5000,"toolAction":"Updating frontend files","toolSummary":"Inject BE2 WebSocket and API integration into frontend"}}]}

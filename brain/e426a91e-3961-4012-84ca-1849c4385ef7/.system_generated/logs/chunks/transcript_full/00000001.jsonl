           };\n\n                // Show toast\n                const toast = document.getElementById(\"self-heal-toast\");\n                toast.style.opacity = \"1\";\n                toast.style.transform = \"translateY(0)\";\n                document.getElementById(\"graph-drifts\").innerText = \"1\";\n\n                setTimeout(() => {\n                  // Update memory node position\n                  submitNode.x += 0.25;\n                  submitNode.color = \"#a855f7\";\n                  document.getElementById(\"node-submit-coords\").innerText = \"(x:350, y:230) [HEALED]\";\n                  document.getElementById(\"node-submit-status\").innerText = \"RE-ANCHORED\";\n                  document.getElementById(\"node-submit-status\").className = \"text-amber-400 text-[10px]\";\n\n                  addLog(\"Visual relocalization SUCCESS. Updated episodic memory graph.\", \"success\");\n                  moveCursorToElement(\"btn-erp-submit\", () => {\n                    addLedgerRecord(\"INV-2026-002\", \"DataCore Logistics\", 3200.50);\n                    addLog(\"✔ Voucher INV-2026-002 processed through healed pathway.\", \"success\");\n                    clearInputs();\n                    banner.style.opacity = \"0\";\n                    banner.style.transform = \"translateY(48px)\";\n                    toast.style.opacity = \"0\";\n                    setTimeout(nextAct, 1800);\n                  });\n                }, 800);\n\n              });\n            });\n          });\n        });\n      }, 1000);\n    }\n\n    // ACT 3: BOUNDARIES & TRUST (The Deterministic Defense)\n    function runAct3() {\n      document.getElementById(\"system-status-text\").innerText = \"ACT III: BOUNDARIES // POLICY INTERCEPT\";\n      document.getElementById(\"system-status-badge\").className = \"px-3 py-1 rounded-full bg-rose-950/80 border border-rose-500/40 text-rose-300 flex items-center space-x-2\";\n      document.getElementById(\"graph-active-task\").innerText = \"MALICIOUS ATTACK INJECTION\";\n      addLog(\">>> ACT III: INJECTING MALICIOUS HIGH-STAKES PAYLOAD\", \"crit\");\n      addLog(\"Attacker voucher: $48,900.00 + Command: 'PURGE_AUDIT_TRAIL'\", \"crit\");\n\n      // Flash Hypervisor Card in danger mode\n      const hypCard = document.getElementById(\"hypervisor-card\");\n      hypCard.className = \"glass-panel-danger rounded-xl flex flex-col h-[560px] overflow-hidden transition-all duration-500 glow-crimson\";\n      document.getElementById(\"blast-radius-badge\").className = \"px-2 py-0.5 rounded bg-rose-950 border border-rose-600 font-mono text-[10px] text-rose-300 font-bold animate-pulse\";\n      document.getElementById(\"blast-radius-badge\").innerText = \"BOUNDARY BREACH\";\n\n      playSynthSound('alarm');\n\n      // Hypervisor intercepts BEFORE motor actuation\n      setTimeout(() => {\n        addLog(\"⛔ BOUNDARY CONTRACT BREACH DETECTED BEFORE MOTOR ACTUATION!\", \"crit\");\n        addLog(\"• VIOLATION: $48,900.00 exceeds safety ceiling $5,000.00\", \"crit\");\n        addLog(\"• VIOLATION: Destructive system command 'purge_audit_logs' intercepted\", \"crit\");\n        addLog(\"PRE-ACTION ATOMIC SNAPSHOT VERIFIED: Zero state corruption permitted.\", \"success\");\n\n        // Render Cryptographic Proof of Boundary\n        document.getElementById(\"pob-status\").innerText = \"CONTRACT ENFORCED\";\n        document.getElementById(\"pob-status\").className = \"text-[9px] px-1.5 py-0.5 rounded bg-rose-950 border border-rose-800 text-rose-300 font-bold\";\n        document.getElementById(\"pob-last-eval\").innerText = \"BLOCKED: GhostShell Syndicate\";\n        document.getElementById(\"pob-last-eval\").className = \"text-rose-400 font-bold\";\n        document.getElementById(\"pob-hash\").innerText = \"POB-9f83a48e718b2c40c8f1e582c0bdfa35b1d49e6f39487c538e\";\n        document.getElementById(\"pob-hash\").className = \"text-[9px] text-rose-300 break-all bg-rose-950/80 p-1.5 rounded font-mono border border-rose-800\";\n        document.getElementById(\"pob-alert-text\").innerHTML = \"<span class='text-rose-400 font-bold'>DETERMINISTICALLY BLOCKED:</span> Mouse actuation locked. Audit ledger preserved 100%.\";\n\n        // Virtual cursor moves away from danger button to neutral safe zone\n        cursor.style.left = \"40px\";\n        cursor.style.top = \"40px\";\n        document.getElementById(\"telemetry-coords\").innerText = \"CURSOR: SAFE_LOCKOUT\";\n\n        addLog(\"=== 3-ACT DEMO COMPLETE: NO CHAT WINDOW. FULL TRUST. ===\", \"success\");\n        isDemoRunning = false;\n      }, 900);\n    }\n\n    function runFullDemo() {\n      if (isDemoRunning) return;\n      isDemoRunning = true;\n      resetSystem();\n      setTimeout(() => {\n        runAct1(() => {\n          runAct2(() => {\n            runAct3();\n          });\n        });\n      }, 500);\n    }\n\n    function simulateManualDrift() {\n      const btn = document.getElementById(\"btn-erp-submit\");\n      const container = document.getElementById(\"erp-actions-container\");\n      isDrifted = !isDrifted;\n      if (isDrifted) {\n        container.classList.add(\"flex-row-reverse\");\n        btn.className = \"px-4 py-1.5 bg-purple-700 hover:bg-purple-800 text-white font-bold text-xs rounded shadow-md transition-all\";\n        btn.innerHTML = \"<span>>> SUBMIT SETTLEMENT <<</span>\";\n        document.getElementById(\"drift-alert-banner\").style.opacity = \"1\";\n        document.getElementById(\"drift-alert-banner\").style.transform = \"translateY(0)\";\n        addLog(\"Manual Chaos Mode engaged: Button relocated.\", \"warn\");\n        playSynthSound('heal');\n      } else {\n        container.classList.remove(\"flex-row-reverse\");\n        btn.className = \"px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded shadow-sm transition-all\";\n        btn.innerHTML = \"<span>[ Process & Wire Payout ]</span>\";\n        document.getElementById(\"drift-alert-banner\").style.opacity = \"0\";\n        document.getElementById(\"drift-alert-banner\").style.transform = \"translateY(48px)\";\n        addLog(\"Manual Chaos Mode disengaged.\", \"info\");\n      }\n    }\n\n    function simulateManualAttack() {\n      runAct3();\n    }\n\n    function resetSystem() {\n      isDemoRunning = false;\n      clearInputs();\n      isDrifted = false;\n\n      // Reset ERP button\n      const btn = document.getElementById(\"btn-erp-submit\");\n      const container = document.getElementById(\"erp-actions-container\");\n      container.classList.remove(\"flex-row-reverse\");\n      btn.className = \"px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded shadow-sm transition-all\";\n      btn.innerHTML = \"<span>[ Process & Wire Payout ]</span>\";\n\n      // Hide banners and toasts\n      document.getElementById(\"drift-alert-banner\").style.opacity = \"0\";\n      document.getElementById(\"drift-alert-banner\").style.transform = \"translateY(48px)\";\n      document.getElementById(\"self-heal-toast\").style.opacity = \"0\";\n\n      // Reset Hypervisor card style\n      const hypCard = document.getElementById(\"hypervisor-card\");\n      hypCard.className = \"glass-panel rounded-xl flex flex-col h-[560px] overflow-hidden border-cyan-500/20\";\n      document.getElementById(\"blast-radius-badge\").className = \"px-2 py-0.5 rounded bg-emerald-950 border border-emerald-700/60 font-mono text-[10px] text-emerald-300 font-bold\";\n      document.getElementById(\"blast-radius-badge\").innerText = \"ZERO LEAK\";\n\n      // Reset PoB card\n      document.getElementById(\"pob-status\").innerText = \"STANDBY\";\n      document.getElementById(\"pob-status\").className = \"text-[9px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400\";\n      document.getElementById(\"pob-last-eval\").innerText = \"Pending next directive\";\n      document.getElementById(\"pob-last-eval\").className = \"text-slate-200\";\n      document.getElementById(\"pob-hash\").innerText = \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\";\n      document.getElementById(\"pob-hash\").className = \"text-[9px] text-slate-500 break-all bg-black/50 p-1 rounded font-mono\";\n      document.getElementById(\"pob-alert-text\").innerText = \"Status: Pre-flight invariant engine ready.\";\n\n      // Reset Status pill\n      document.getElementById(\"system-status-text\").innerText = \"SYSTEM ARMED // IDLE\";\n      document.getElementById(\"system-status-badge\").className = \"px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 flex items-center space-x-2\";\n      document.getElementById(\"graph-active-task\").innerText = \"IDLE\";\n      document.getElementById(\"graph-drifts\").innerText = \"0\";\n\n      // Reset memory nodes\n      const submitNode = memoryNodes.find(n => n.id === \"submit\");\n      submitNode.x = 0.50;\n      submitNode.color = \"#10b981\";\n      driftVectorAnim = null;\n      document.getElementById(\"node-submit-coords\").innerText = \"(x:110, y:230)\";\n      document.getElementById(\"node-submit-status\").innerText = \"CACHED\";\n      document.getElementById(\"node-submit-status\").className = \"text-emerald-400 text-[10px]\";\n\n      // Cursor home\n      cursor.style.left = \"240px\";\n      cursor.style.top = \"220px\";\n      document.getElementById(\"telemetry-coords\").innerText = \"CURSOR: (240, 220)\";\n\n      addLog(\"System reset: pristine baseline restored.\", \"info\");\n    }\n  </script>\n</body>\n</html>\n","Description":"Interactive Mission Control and Simulator frontend for AegisOS featuring virtual desktop OS actuation simulation, live HTML5 canvas episodic memory graph, deterministic boundary hypervisor with cryptographic Proof-of-Boundary cards, Web Audio synthesizer, and 3-Act hackathon demo automation.","Overwrite":true,"TargetFile":"C:\\Users\\Piyush\\.gemini\\antigravity\\brain\\e426a91e-3961-4012-84ca-1849c4385ef
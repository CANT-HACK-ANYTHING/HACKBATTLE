{"step_index":91,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-12T08:48:51Z","content":"Created At: 2026-09-12T14:18:51+05:30\nCompleted At: 2026-09-12T14:18:51+05:30\nFile Path: `file:///C:/Users/Piyush/.gemini/antigravity/scratch/aegis_os/frontend/index.html`\nTotal Lines: 1039\nTotal Bytes: 49887\nShowing lines 480 to 600\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n480:       document.getElementById(\"btn-sound-toggle\").classList.toggle(\"text-cyan-400\", soundEnabled);\n481:     }\n482: \n483:     function playSynthSound(type) {\n484:       if (!soundEnabled) return;\n485:       try {\n486:         initAudio();\n487:         if (audioCtx.state === 'suspended') {\n488:           audioCtx.resume();\n489:         }\n490: \n491:         const now = audioCtx.currentTime;\n492: \n493:         if (type === 'blip') {\n494:           const osc = audioCtx.createOscillator();\n495:           const gain = audioCtx.createGain();\n496:           osc.type = 'sine';\n497:           osc.frequency.setValueAtTime(880, now);\n498:           osc.frequency.exponentialRampToValueAtTime(1760, now + 0.08);\n499:           gain.gain.setValueAtTime(0.08, now);\n500:           gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);\n501:           osc.connect(gain);\n502:           gain.connect(audioCtx.destination);\n503:           osc.start(now);\n504:           osc.stop(now + 0.08);\n505:         } else if (type === 'type') {\n506:           const osc = audioCtx.createOscillator();\n507:           const gain = audioCtx.createGain();\n508:           osc.type = 'triangle';\n509:           osc.frequency.setValueAtTime(320 + Math.random() * 80, now);\n510:           gain.gain.setValueAtTime(0.04, now);\n511:           gain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);\n512:           osc.connect(gain);\n513:           gain.connect(audioCtx.destination);\n514:           osc.start(now);\n515:           osc.stop(now + 0.03);\n516:         } else if (type === 'heal') {\n517:           const osc = audioCtx.createOscillator();\n518:           const gain = audioCtx.createGain();\n519:           osc.type = 'sawtooth';\n520:           osc.frequency.setValueAtTime(440, now);\n521:           osc.frequency.exponentialRampToValueAtTime(880, now + 0.2);\n522:           gain.gain.setValueAtTime(0.09, now);\n523:           gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);\n524:           osc.connect(gain);\n525:           gain.connect(audioCtx.destination);\n526:           osc.start(now);\n527:           osc.stop(now + 0.25);\n528:         } else if (type === 'alarm') {\n529:           // Harsh two-tone warning klaxon\n530:           const osc = audioCtx.createOscillator();\n531:           const gain = audioCtx.createGain();\n532:           osc.type = 'sawtooth';\n533:           osc.frequency.setValueAtTime(220, now);\n534:           osc.frequency.setValueAtTime(160, now + 0.15);\n535:           osc.frequency.setValueAtTime(220, now + 0.3);\n536:           gain.gain.setValueAtTime(0.15, now);\n537:           gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);\n538:           osc.connect(gain);\n539:           gain.connect(audioCtx.destination);\n540:           osc.start(now);\n541:           osc.stop(now + 0.5);\n542:         }\n543:       } catch (e) {\n544:         console.warn(\"Audio synthesis error:\", e);\n545:       }\n546:     }\n547: \n548:     // =========================================================================\n549:     // 2. CANVAS EPISODIC MEMORY GRAPH VISUALIZATION\n550:     // =========================================================================\n551:     const canvas = document.getElementById(\"memory-canvas\");\n552:     const ctx = canvas.getContext(\"2d\");\n553: \n554:     function resiz